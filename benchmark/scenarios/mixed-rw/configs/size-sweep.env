# size-sweep: value-size sensitivity (baseline, no tiering)
#
# Uses the same constant-maxmemory keyspace derivation as size-sweep-fc so that
# keyspaces are identical and results are directly comparable.  MAXMEMORY_OVERRIDE=0
# disables the memory cap after derivation (no eviction, all data stays in RAM).
#
# Derived sweep (MAXMEMORY_MB=512, KEYSIZE=100 → per_key≈164, HOT_PCT=10):
#   value     keyspace    dataset   note
#   500 B     ~2.41M      1.2 GB    same as FC leg
#   5 KB      ~776K       3.9 GB    same as FC leg
#   500 KB    ~10.3K      5.1 GB    same as FC leg
#   5 MB      ~1031       5.2 GB    same as FC leg
DATATYPE=string
SWEEP_ITEM_SIZE="500 5000 500000 5000000"
MAXMEMORY_MB=512
KEYSIZE=100
HOT_PCT=10
VALKEY_OVERHEAD_MB=20
MAXMEMORY_OVERRIDE=0
MAXMEMORY_POLICY=noeviction
CLIENTS=200
DURATION=60
READ_PCT=80
ACCESS_PATTERN=zipfian
