# size-sweep-fc: value-size sensitivity (FlashCache tiering)
#
# Constant-maxmemory model: hold maxmemory FIXED across the sweep and derive the
# keyspace per value size from
#     KEYSPACE = (maxmemory - overhead) / (per_key + HOT_PCT/100 * value_size)
# (see scenarios/mixed-rw/run.sh, "Sizing model" block).
#
# This keeps a single value a small fraction of maxmemory at every size (≈1% at
# 5 MB, far less below), so a concurrent populate burst (CLIENTS * value) never
# blows past the cap. It replaces the old DATASET_BYTES model, which shrank
# maxmemory as values grew and OOM-rejected the ≥500 KB legs during populate.
#
# Derived sweep (MAXMEMORY_MB=512, KEYSIZE=100 → per_key≈164, HOT_PCT=10):
#   value     keyspace    dataset   value/maxmem
#   500 B     ~2.41M      1.2 GB    0.0001%
#   5 KB      ~776K       3.9 GB    0.001%
#   500 KB    ~10.3K      5.1 GB    0.10%
#   5 MB      ~1031       5.2 GB    0.95%
DATATYPE=string
SWEEP_ITEM_SIZE="500 5000 500000 5000000"
MAXMEMORY_MB=512
KEYSIZE=100
HOT_PCT=10
VALKEY_OVERHEAD_MB=20
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
DURATION=60
READ_PCT=80
ACCESS_PATTERN=zipfian
# FlashCache capacity must exceed the largest spilled set (~4.3 GB) with margin.
# The harness pre-allocates this file before server start (FlashCache won't create it).
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 10240 --activedefrag yes"
