# mixed-rw: Zipfian access, FlashCache tiering
ACCESS_PATTERN=zipfian
ZIPFIAN_ALPHA=1.0
MAXMEMORY=100mb
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
OPS=10000000
KEYSPACE=500000
ITEM_SIZE=400
KEYSIZE=100
READ_PCT=80
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 2048 --activedefrag yes"
