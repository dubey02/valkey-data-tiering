# Size sweep - large values (500KB + 5MB)
# Uses small keyspace to ensure populate completes quickly with large values.
# Keyspace sized so ~90% of data is on disk: KEYSPACE >> maxmemory/value_size.
DATATYPE=string
SWEEP_ITEM_SIZE="500000 5000000"
MAXMEMORY_MB=512
KEYSIZE=100
HOT_PCT=50
VALKEY_OVERHEAD_MB=20
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=50
DURATION=60
READ_PCT=80
ACCESS_PATTERN=zipfian
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 10240 --activedefrag yes --ext-storage-max-buffered-write-size 268435456 --ext-storage-buffered-write-flush-threshold 4194304"
