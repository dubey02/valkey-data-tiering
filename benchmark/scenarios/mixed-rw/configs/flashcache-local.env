# mixed-rw: Zipfian access, FlashCache tiering — local dev (no NVMe required)
#
# Local twin of zipfian-flashcache: same workload shape and maxmemory so results are
# comparable, but backed by a file in /tmp instead of /mnt/nvme, and 10x fewer ops so it
# finishes quickly. benchmark.sh pre-allocates the backing file, so this costs 2 GB of /tmp.
#
# maxmemory must cover the DRAM key floor (KEYSPACE * (KEYSIZE + 64) = 78 MB here) with
# enough left over to cache a hot set; see "Sizing constraint" in benchmark/README.md.
ACCESS_PATTERN=zipfian
ZIPFIAN_ALPHA=1.0
MAXMEMORY=100mb
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
OPS=1000000
KEYSPACE=500000
ITEM_SIZE=400
KEYSIZE=100
READ_PCT=80
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /tmp/flashcache.db --ext-storage-capacity-mb 2048 --activedefrag yes"
