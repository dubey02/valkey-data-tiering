# W3: Mixed R/W with FlashCache tiering (local dev - /tmp path)
# 80/20 read/write split, memory-constrained to force spilling
MAXMEMORY=32mb
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
OPS=1000000
KEYSPACE=500000
DATASIZE=400
KEYSIZE=100
READ_PCT=80
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /tmp/flashcache.db --ext-storage-capacity-mb 2048 --activedefrag yes"
