# Zipfian baseline — module backend (same workload as zipfian-1gb.env)
# Uses flash-tiering module instead of native flashcache backend
ACCESS_PATTERN=zipfian
ZIPFIAN_ALPHA=1.0
MAXMEMORY=1gb
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
OPS=50000000
PIPELINE=1
KEYSPACE=4000000
ITEM_SIZE=512
KEYSIZE=100
READ_PCT=80
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --loadmodule /tmp/valkey-bench/libflash_tiering_module.so backend=flashcache db_path=/mnt/nvme/flashcache.db db_size_bytes=8589934592 --activedefrag yes"
