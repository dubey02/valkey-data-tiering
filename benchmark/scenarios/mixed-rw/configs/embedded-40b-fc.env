# embedded-40b-fc: Embedded-value spill validation on real FlashCache/NVMe.
# Entries are 16B key + 40B value => total robj ~88B <= 128B embed threshold
# (shouldEmbedStringObject), so every value is EMBEDDED (verified embstr) —
# exercises the embedded-spill tombstone-swap and re-embed restore paths
# under memory pressure with concurrent fetch promotions.
#
# Same shape as size-sweep-fc: HOT_PCT=10 (target ~10% of value bytes in
# DRAM, maxmemory derived), READ_PCT=80, zipfian. PER_KEY_BYTES overridden
# to the MEASURED embedded tombstone floor on this host: 2M fully-tiered
# keys = 125MB ex-overhead => ~64B/key (default KEYSIZE+64 assumes a
# non-embedded entry and overestimates). Derived maxmemory ≈ 156MB.
# Actual residency measured at run time (expect drift from the ~1.1x
# steady-state overshoot band).
DATATYPE=string
ITEM_SIZE=40
KEYSIZE=16
KEYSPACE=2000000
HOT_PCT=10
PER_KEY_BYTES=64
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
OPS=2000000
READ_PCT=80
ACCESS_PATTERN=zipfian
ZIPFIAN_ALPHA=1.0
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 2048"
