# Uniform baseline — 1GB maxmemory, 4M keys, 512B values
# Identical to zipfian-1gb except ACCESS_PATTERN=uniform (no hot set).
# Worst-case for tiering: every key equally likely → ~79% GETs hit disk.
ACCESS_PATTERN=uniform
MAXMEMORY=1gb
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
OPS=50000000
PIPELINE=1
KEYSPACE=4000000
ITEM_SIZE=512
KEYSIZE=100
READ_PCT=80
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 8192 --activedefrag yes"
