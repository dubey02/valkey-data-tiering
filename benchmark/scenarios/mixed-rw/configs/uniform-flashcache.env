# mixed-rw: uniform access, Valkey Data Tiering (FlashCache) — size x data-type matrix.
#
# Tiered half of the matrix. Pairs 1:1 with uniform.env (plain Valkey baseline): same sweep,
# same keyspace derivation, same traffic. The only difference is that this one caps DRAM at
# MAXMEMORY_MB and spills to flash, so a leg-for-leg diff isolates the cost of tiering.
#
# 4 sizes x 6 data types = 24 legs. Results land under
# results/<tag>/mixed-rw/uniform-flashcache/value_bytes-<N>/datatype-<T>/
SWEEP_VALUE_BYTES="500 5000 500000 5000000"
SWEEP_DATATYPE="string zset set hash list stream"
ACCESS_PATTERN=uniform

# Keyspace is derived from a constant maxmemory so every leg holds the same hot fraction of
# DRAM: KEYSPACE = (MAXMEMORY_MB - VALKEY_OVERHEAD_MB) / (per_key + HOT_PCT% of value bytes).
MAXMEMORY_MB=512
HOT_PCT=10
VALKEY_OVERHEAD_MB=20
KEYSIZE=100

# Compound types scale by item count at a fixed element size, so VALUE_BYTES/50 elements.
# A 500B set is 10 x 50B, a 5MB set is 100k x 50B. Scaling the element instead would put each
# element over PROTO_INLINE_MAX_SIZE (64KB) at the large sizes, and the populate path pipes
# inline commands -- an over-limit inline command is dropped silently, yielding an empty keyspace.
COMPOUND_ITEM_SIZE=50
MAXMEMORY_POLICY=allkeys-lru

READ_PCT=80
CLIENTS=200
DURATION=60

# Flash capacity must exceed the spilled set with margin; the harness pre-allocates the file.
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 10240 --activedefrag yes"
