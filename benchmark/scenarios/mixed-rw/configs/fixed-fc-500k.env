# fixed-fc-500k: single 500 KB value size, FlashCache tiering (no sweep).
#
# Identical sizing model to size-sweep-fc.env but pinned to the 500 KB leg only,
# for fast iteration on the throttle band. The 500 KB leg is the one that
# OOM-rejected during populate under the original [1.1x, 1.2x] band. The band has
# since been widened to [1.0x, 1.2x] (ext-storage-throttle-band-start/-end default
# to 100/120) and this config still does not converge: populate advances ~212 keys
# per attempt before the client is OOM-rejected and killed.
#
# Derived (MAXMEMORY_MB=512, KEYSIZE=100 -> per_key~164, HOT_PCT=10):
#   value     keyspace    dataset   value/maxmem
#   500 KB    ~10.3K      5.1 GB    0.10%
DATATYPE=string
ITEM_SIZE=500000
MAXMEMORY_MB=512
KEYSIZE=100
HOT_PCT=10
VALKEY_OVERHEAD_MB=20
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
OPS=2000000
READ_PCT=80
ACCESS_PATTERN=zipfian
# FlashCache capacity must exceed the spilled set (~5.1 GB) with margin.
# The harness pre-allocates this file before server start (FlashCache won't create it).
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 10240 --rdbcompression no"
POPULATE_CLIENTS=1
