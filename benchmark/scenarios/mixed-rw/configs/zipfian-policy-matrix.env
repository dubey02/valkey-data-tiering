# mixed-rw: Zipfian access, FlashCache tiering — POLICY MATRIX sweep.
# Same params as zipfian-flashcache.env, but sweeps the admission × promotion
# policy matrix (2x2 cartesian -> 4 passes):
#   dram+always, dram+never, flash+always, flash+never
# benchmark.sh injects ADMISSION/PROMOTION as --ext-storage-admission-policy /
# --ext-storage-promotion-policy server args (benchmark.sh:482-488).
ACCESS_PATTERN=zipfian
ZIPFIAN_ALPHA=1.0
MAXMEMORY=100mb
MAXMEMORY_POLICY=allkeys-lru
CLIENTS=200
OPS=10000000
KEYSPACE=500000
DATASIZE=400
KEYSIZE=100
READ_PCT=80
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 2048"

# Policy matrix sweep: admission × promotion (cartesian product -> 4 runs)
SWEEP_ADMISSION="dram flash"
SWEEP_PROMOTION="always never 2hit-50k"
