# Zipfian baseline — NO TIERING (all data in memory)
# Same workload params as zipfian-1gb.env for apple-to-apple comparison
# maxmemory=0 means unlimited memory (all 4M keys fit in ~2.5GB RAM)
ACCESS_PATTERN=zipfian
ZIPFIAN_ALPHA=1.0
MAXMEMORY=0
MAXMEMORY_POLICY=noeviction
CLIENTS=200
OPS=50000000
PIPELINE=1
KEYSPACE=4000000
ITEM_SIZE=512
KEYSIZE=100
READ_PCT=80
SERVER_EXTRA_ARGS="--activedefrag yes"
