# mixed-rw: uniform access, plain Valkey baseline — size x data-type matrix.
#
# Baseline half of the matrix. Pairs 1:1 with uniform-flashcache.env: same sweep, same
# keyspace derivation, same traffic, but no tiering and no maxmemory, so the whole dataset is
# DRAM-resident. MAXMEMORY_OVERRIDE=0 keeps the keyspace derivation below while running
# uncapped -- the keyspace must match the tiered run for the comparison to mean anything.
#
# 5 sizes x 6 data types = 30 legs. Results land under
# results/<tag>/mixed-rw/uniform/value_bytes-<N>/datatype-<T>/
SWEEP_VALUE_BYTES="100 500 5000 500000 5000000"
SWEEP_DATATYPE="string zset set hash list stream"
ACCESS_PATTERN=uniform

# Keyspace is derived from a constant maxmemory so every leg holds the same hot fraction of
# DRAM: KEYSPACE = (MAXMEMORY_MB - VALKEY_OVERHEAD_MB) / (per_key + HOT_PCT% of value bytes).
MAXMEMORY_MB=512
HOT_PCT=10
VALKEY_OVERHEAD_MB=20
KEYSIZE=100
ITEMS_PER_KEY=10

# Derive the keyspace from MAXMEMORY_MB above, then run with no cap at all.
MAXMEMORY_OVERRIDE=0
MAXMEMORY_POLICY=noeviction

READ_PCT=80
CLIENTS=200
DURATION=60
SERVER_EXTRA_ARGS="--activedefrag yes"
