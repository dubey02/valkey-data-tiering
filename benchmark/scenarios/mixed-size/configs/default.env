# mixed-size/default: Small/fast smoke baseline (no tiering)
# zipfian works with arbitrary-command mode now (valkey-benchmark zipfianInit fix);
# uniform kept here just for a deterministic local smoke.
MAXMEMORY=0
MAXMEMORY_POLICY=noeviction
MIX_CLASSES="string:512:100:70 set:4096:100:30"
KEYSPACE=10000
OPS=50000
CLIENTS=50
READ_PCT=80
ACCESS_PATTERN=uniform
ITEMS_PER_KEY=10
