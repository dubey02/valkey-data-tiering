# Idle, HASH, NO TIERING control: same dataset/traffic as idle-hash.env but
# keys stay in RAM (SPILL=no skips DEBUG SPILL; tiering left disabled). Isolates
# the idle latency floor without a fetch path.
MAXMEMORY=4gb
MAXMEMORY_POLICY=noeviction
KEY_COUNT=10
KEY_SIZE=100
VALUE_SIZE=1024
SYNTH_TYPE=hash
SYNTH_ITEMS=1000
RPS=1
CLIENTS=1
SPILL=no
SERVER_EXTRA_ARGS="--enable-debug-command yes"
