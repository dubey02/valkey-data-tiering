# Slam: 100% of reads go to disk at unbounded TPS (storage layer saturated)
# MAXMEMORY must be >0 or completions never drain (ext_storage.c:909 early-returns
# when maxmemory==0). noeviction ensures only DEBUG SPILL spills, nothing automatic.
# Must fit 1M keys (~100B key + ~400B val + overhead) in RAM before manual spill.
MAXMEMORY=8gb
MAXMEMORY_POLICY=noeviction
KEY_COUNT=1000000
KEY_SIZE=100
VALUE_SIZE=400
RPS=0
CLIENTS=200
# Reuse the pre-sized /mnt/nvme/flashcache.db (2048MB). FlashCache asserts the
# backing file size matches capacity. 2048MB holds 1M x ~512B spilled values.
SERVER_EXTRA_ARGS="--ext-storage-enabled yes --ext-storage-backend flashcache --ext-storage-path /mnt/nvme/flashcache.db --ext-storage-capacity-mb 2048 --enable-debug-command yes"
