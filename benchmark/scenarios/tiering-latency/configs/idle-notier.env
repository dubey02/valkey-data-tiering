# Idle, NO TIERING control: same traffic as idle.env but keys stay in RAM.
# SPILL=no skips DEBUG SPILL; tiering left disabled on the server. Isolates whether
# the idle latency floor is the same without a fetch path.
MAXMEMORY=4gb
MAXMEMORY_POLICY=noeviction
KEY_COUNT=10
KEY_SIZE=100
VALUE_SIZE=400
RPS=1
CLIENTS=1
SPILL=no
SERVER_EXTRA_ARGS="--enable-debug-command yes"
