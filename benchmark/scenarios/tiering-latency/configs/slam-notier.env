# Slam, NO TIERING control: same 1M-key unbounded-TPS read load as slam.env but
# keys stay in RAM (SPILL=no, tiering disabled). If server p100 still spikes ~10x under
# load, the tail is load-induced thread preemption, not the tiering fetch path.
MAXMEMORY=8gb
MAXMEMORY_POLICY=noeviction
KEY_COUNT=1000000
KEY_SIZE=100
VALUE_SIZE=400
RPS=0
CLIENTS=200
SPILL=no
SERVER_EXTRA_ARGS="--enable-debug-command yes"
